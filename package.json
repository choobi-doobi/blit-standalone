{
  "name": "blit",
  "version": "2.0.0",
  "description": "Live-code pixel art and sprite animation in the browser",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "node scripts/generate-render-runtime.mjs --check && vite build",
    "start": "tsx server/index.ts",
    "runtime": "node scripts/generate-render-runtime.mjs",
    "mcp": "tsx mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/generate-render-runtime.mjs --check && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "11.10.0",
    "express": "4.22.1",
    "tsx": "4.21.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lint": "6.9.5",
    "@codemirror/state": "6.7.0",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.4",
    "@fluentui/react-components": "9.74.8",
    "@fluentui/react-icons": "2.0.341",
    "@lezer/common": "1.5.1",
    "@lezer/javascript": "1.5.4",
    "@tanstack/react-query": "5.90.19",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "4.17.25",
    "@types/node": "22.19.7",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@types/supertest": "7.2.0",
    "@uiw/react-codemirror": "4.25.10",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.4.23",
    "concurrently": "8.2.2",
    "esbuild": "0.27.2",
    "jsdom": "26.1.0",
    "postcss": "8.5.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.3",
    "supertest": "7.2.2",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.0.5",
    "vitest": "4.1.2"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.2": true
  }
}
